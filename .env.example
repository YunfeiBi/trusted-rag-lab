# Copy to .env; never commit .env. Admin credential is only for local setup.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_ADMIN_DB=postgres
POSTGRES_DB=trusted_rag_lab
POSTGRES_USER=trusted_rag_app
POSTGRES_PASSWORD=
# Use a trusted service authorized for your documents.
MODEL_BASE_URL=
MODEL_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=
# Leave empty to reuse MODEL_BASE_URL and MODEL_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANK_MODEL=
# Leave empty to reuse the embedding service for SiliconFlow-style /rerank.
RERANK_BASE_URL=
RERANK_API_KEY=

# Resource limits. Existing .env files are not overwritten; defaults apply.
MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=500
MAX_TEXT_CHARS=500000
MAX_CHUNKS=1500
PARSE_TIMEOUT_SECONDS=60
PROCESSING_TIMEOUT_SECONDS=240
